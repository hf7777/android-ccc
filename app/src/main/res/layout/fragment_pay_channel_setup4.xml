<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="15dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_bank_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_color_black"
                android:text="@string/please_add_bank_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="15dp"/>

            <TextView
                android:id="@+id/tv_upi_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_black"
                android:textSize="15sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_bank_card_title"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_account_no_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_number"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_upi_display"
                android:layout_marginTop="16dp"/>

            <com.hjq.shape.view.ShapeEditText
                android:id="@+id/et_account_no"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                app:shape_radius="10dp"
                android:textSize="15sp"
                android:textColor="@color/text_color_black"
                android:textColorHint="@color/edit_hint"
                android:hint="@string/enter_account_number"
                android:inputType="number"
                android:singleLine="true"
                app:shape_strokeSize="1dp"
                app:shape_strokeColor="@color/edit_stroke_normal"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp"
                app:layout_constraintTop_toBottomOf="@id/tv_account_no_title"
                android:layout_marginTop="9dp"/>

            <TextView
                android:id="@+id/tv_bank_name_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bank_name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_account_no"
                android:layout_marginTop="11dp"/>

            <com.hjq.shape.view.ShapeEditText
                android:id="@+id/et_bank_name"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                app:shape_radius="10dp"
                android:textSize="15sp"
                android:textColor="@color/text_color_black"
                android:textColorHint="@color/edit_hint"
                android:hint="@string/enter_bank_name"
                android:inputType="text"
                android:singleLine="true"
                app:shape_strokeSize="1dp"
                app:shape_strokeColor="@color/edit_stroke_normal"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp"
                app:layout_constraintTop_toBottomOf="@id/tv_bank_name_title"
                android:layout_marginTop="9dp"/>

            <TextView
                android:id="@+id/tv_upi_pin_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upi_pin"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_bank_name"
                android:layout_marginTop="11dp"/>

            <com.hjq.shape.view.ShapeEditText
                android:id="@+id/et_upi_pin"
                android:layout_width="0dp"
                android:layout_height="51dp"
                app:shape_radius="10dp"
                android:textSize="15sp"
                android:textColor="@color/text_color_black"
                android:textColorHint="@color/edit_hint"
                android:hint="@string/enter_upi_pin"
                android:inputType="numberPassword"
                android:singleLine="true"
                app:shape_strokeSize="1dp"
                app:shape_strokeColor="@color/edit_stroke_normal"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp"
                app:layout_constraintTop_toBottomOf="@id/tv_upi_pin_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="10dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.hjq.shape.view.ShapeButton
        android:id="@+id/btn_finish"
        style="@style/ButtonStyle"
        android:text="@string/finish"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="15dp"
        android:enabled="false"
        app:shape_solidDisabledColor="@color/btn_disabled"/>

</LinearLayout>